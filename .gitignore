# Публикуемость репо: ничего личного и регенерируемого в истории.
# Принцип: репо публикует ИНСТРУМЕНТЫ, а не результаты их применения к самому
# киту. Внутренняя кухня (ТЗ, журнал постройки, аудиты, планы, хендоффы) живёт
# в docs/private/ и в git не попадает.

# Внутренний слой владельца: ТЗ, прогресс, блокеры, бэклог, журнал решений,
# аудиты, аналитические записки, планы реализации, хендоффы.
docs/private/

# Сессионная механика: точка входа сессии и снапшот. По природе приватные и
# постоянно меняющиеся файлы (паттерн .env). В репо лежит только шаблон
# docs/NEW_SESSION_PROMPT.example.md.
docs/NEW_SESSION_PROMPT.md
docs/.session-current.md

# Артефакты evals (модуль 11): карточки/базлайн, содержат счётчики использования
# из приватных транскриптов. Регенерируются eval.sh.
docs/evals/

# Сырьё и черновики консолидации памяти (модуль 12): приватные транскрипты и
# снапшоты. Регенерируются consolidate.sh; принятый дистиллят владелец мержит вручную.
docs/consolidation/

# Локальные настройки Claude Code и загрузки Telegram-моста.
.claude/settings.local.json
.ccgram-uploads/

# Русская версия арх-визуализации - личный слой владельца, регенерируема
# (см. команду /arch-viz, шаг 4). Публичная каноника - английская.
docs/arch/*.ru.json
docs/arch/*.ru.html
