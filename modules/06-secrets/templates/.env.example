# Environment variables template. Origin: proven donor .env.example pattern.
# Copy to .env.local for development. Real values are NEVER committed.
# Where real values live:
#   web prod  - Vercel -> Project -> Environment Variables
#   CI        - GitHub -> Settings -> Secrets and variables -> Actions
#   iOS build - Codemagic -> app -> Environment variables, group "ios"

# --- Required (app does not start without these) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional ---
# Sentry error reporting (module 05-monitoring).
VITE_SENTRY_DSN=
# Public app URL override (defaults to production URL).
VITE_APP_URL=
# Enable in-app debug toolkit / CI mode flags (module 04-staging).
VITE_DEV_TOOLS=
